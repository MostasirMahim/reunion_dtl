# ---------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# Then load it before running the server, e.g.:
#   export $(cat .env | xargs)   (Linux/Mac)
#   or use django-environ / python-dotenv in production
# ---------------------------------------------------------------------

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,gbcreunion-clone.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gbcreunion-clone.com

# Site base URL (no trailing slash) - used to build SSLCommerz callback URLs
SITE_BASE_URL=http://127.0.0.1:8000

# ---- Database (leave blank to use sqlite3) ----
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=bssreunion
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ---- Email (SMTP) ----
# For local development, leave EMAIL_BACKEND as console backend (prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, switch to:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=BSSREUNION <no-reply@bssreunion.com>

# ---- SSLCommerz ----
# Default values below are SSLCommerz's public sandbox demo credentials.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=True

# ---- Event / Site Settings ----
SCHOOL_NAME=Baraibunia Secondary School
EVENT_SHORT_NAME=BSSREUNION
EVENT_FULL_NAME=BSS Reunion 2026
EVENT_DATE_TEXT=To be announced
EVENT_VENUE=Baraibunia Secondary School Campus
REGISTRATION_FEE=1020
